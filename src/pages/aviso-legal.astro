---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { fillLegal } from '../utils/legal';

const sections = [
  {
    title: 'Datos del titular',
    body: [
      'Titular del sitio: {{RAZON_SOCIAL}} · NIF/RIF: {{NIF/RIF}}',
      'Domicilio: {{DOMICILIO}}',
      'Contacto: {{EMAIL_PRIVACIDAD}}',
    ],
  },
  {
    title: 'Condiciones de uso',
    body: [
      'El acceso a este sitio es gratuito y atribuye la condición de usuario. El usuario se compromete a hacer un uso lícito del sitio y de sus contenidos.',
      'La información publicada tiene carácter informativo y puede modificarse sin previo aviso. Las propuestas comerciales se formalizan por escrito.',
    ],
  },
  {
    title: 'Propiedad intelectual',
    body: [
      'Los textos, imágenes, logotipos y el diseño del sitio pertenecen a {{RAZON_SOCIAL}} o a sus licenciantes. Las marcas de terceros (NTN, SKF, FAG, NSK, TIMKEN, INA, etc.) pertenecen a sus respectivos titulares y se citan solo con fines informativos.',
    ],
  },
  {
    title: 'Responsabilidad y enlaces',
    body: [
      '{{RAZON_SOCIAL}} no se hace responsable de los contenidos de sitios de terceros enlazados desde esta web ni de los daños derivados de un uso indebido del sitio.',
    ],
  },
];
---

<BaseLayout title="Aviso legal" description="Datos del titular, condiciones de uso y propiedad intelectual del sitio.">
  <PageHero
    eyebrow="Legal"
    title="Aviso legal"
    breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Aviso legal' }]}
  />

  <section class="section">
    <div class="container">
      <article class="article">
        <div class="prose">
          {sections.map((section) => (
            <>
              <h2>{section.title}</h2>
              {section.body.map((paragraph) => <p>{fillLegal(paragraph)}</p>)}
            </>
          ))}
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
