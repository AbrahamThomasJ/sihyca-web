---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" noindex>
  <section class="error-page">
    <div class="container">
      <p class="error-code">404</p>
      <h1>No encontramos esta página</h1>
      <p>
        El enlace puede estar roto o la página cambió de ubicación. Estamos
        aquí para ayudarte a encontrar lo que necesitas.
      </p>
      <div class="actions-inline">
        <a class="btn btn--primary" href="/">Volver al inicio</a>
        <a class="btn btn--outline" href="/contact-us/">Contacto</a>
      </div>
    </div>
  </section>
</BaseLayout>
