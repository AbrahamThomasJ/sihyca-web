---
import Icon from './Icon.astro';
import { whatsappLink } from '../data/site';

interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
  showWhatsApp?: boolean;
}

const {
  title = 'Tu operación necesita proveedores confiables',
  text = 'Sabemos que en la industria no hay espacio para errores, retrasos o componentes de baja calidad. Si buscas productos confiables, respaldo técnico y soluciones industriales de alto nivel, conversemos y encontremos exactamente lo que tu operación necesita.',
  href = '/contact-us/',
  label = 'Solicitar Cotización',
  showWhatsApp = true,
} = Astro.props;

const waLink = whatsappLink();
---

<section class="cta">
  <div class="container">
    <div class="cta-panel">
      <div>
        <p class="eyebrow">Hablemos</p>
        <h2>{title}</h2>
        <p>{text}</p>
        <div class="cta-panel__actions">
          <a class="btn btn--light" href={href}>
            {label}
            <Icon name="arrow-right" />
          </a>
          {showWhatsApp && waLink && (
            <a
              class="btn btn--ghost-light"
              href={waLink}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="whatsapp" />
              WhatsApp directo
            </a>
          )}
        </div>
      </div>

      <div class="cta-panel__art" aria-hidden="true">
        <svg viewBox="0 0 240 240" role="presentation">
          <circle cx="120" cy="120" r="104" fill="none" stroke="rgba(127,196,245,0.3)" stroke-width="1.5" />
          <circle cx="120" cy="120" r="78" fill="none" stroke="rgba(127,196,245,0.45)" stroke-width="1.5" />
          <circle cx="120" cy="120" r="46" fill="none" stroke="rgba(127,196,245,0.7)" stroke-width="2" />
          <circle cx="120" cy="120" r="22" fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="2" />
          <g fill="rgba(127,196,245,0.9)">
            <circle cx="120" cy="20" r="4" />
            <circle cx="190.7" cy="49.3" r="4" />
            <circle cx="220" cy="120" r="4" />
            <circle cx="190.7" cy="190.7" r="4" />
            <circle cx="120" cy="220" r="4" />
            <circle cx="49.3" cy="190.7" r="4" />
            <circle cx="20" cy="120" r="4" />
            <circle cx="49.3" cy="49.3" r="4" />
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>
